#!/bin/sh
# 키·비밀값이 실수로 커밋되는 걸 막음. 정말 필요하면 git commit --no-verify
blocked_files=$(git diff --cached --name-only --diff-filter=ACM | grep -iE '\.jks$|\.keystore$|keystore\.properties$|\.env\.release$|(^|/)local\.properties$|\.p12$|\.pem$|google-services\.json$')
if [ -n "$blocked_files" ]; then
  echo "✖ 커밋하면 안 되는 파일이 있어요:"
  echo "$blocked_files" | sed 's/^/   /'
  echo "  → git restore --staged <파일> 로 빼 주세요."
  exit 1
fi
leaked=$(git diff --cached -U0 | grep '^+' | grep -v '^+++' | grep -nE 'BEGIN [A-Z ]*PRIVATE KEY|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AIza[0-9A-Za-z_-]{35}|(store|key)Password=[^$<[:space:]]')
if [ -n "$leaked" ]; then
  echo "✖ 비밀번호·키처럼 보이는 내용이 들어 있어요. 확인 후 빼 주세요."
  exit 1
fi
exit 0
